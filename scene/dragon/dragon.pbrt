Sampler "halton"
  "integer pixelsamples" 6
LookAt 1 0.8 3
       0 -0.1 -0.2
       0 1 0

Camera "perspective"
    "float fov" 26.2

Film "rgb"
  "integer xresolution" 1920
  "integer yresolution" 1080
  "string filename" "dragon.exr"

Integrator "volpath"
  #"integer maxdepth" 1

WorldBegin

#LightSource "infinite" "rgb L" [ 1 1 1 ]
AttributeBegin
  Rotate -67.2614 0 1 0
  Rotate -90 1 0 0
  LightSource "infinite" "string filename" "FlowCheck.exr"
AttributeEnd

AttributeBegin
  Translate 0 -0.6 0
  Scale 50 50 50
  Material "diffuse" "rgb reflectance" [ 0.2 0.2 0.2 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 5 0
  Scale 0.5 0.5 0.5
  AreaLightSource "diffuse" "rgb L" [200 200 200] "float scale" 0.31830988618379067154
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  AttributeBegin
    Rotate 180 0 1 0
    Scale 0.01 0.01 0.01
    MakeNamedMedium "macrofacet" "string type" "macrofacetvdb" 
      "string filename" "dragon.nvdb"
      "string ndf" "gp"
      "rgb albedo" [ 0.9 0.56 0.43 ]
  AttributeEnd
  AttributeBegin
    Material "interface"
    MediumInterface "macrofacet" ""
    #Material "conductor" "rgb reflectance" [1.0 1.0 1.0] "float roughness" 0.25
    Scale 2 0.55 1
    Shape "plymesh" "string filename" "cube.ply"
    #Shape "plymesh" "string filename" "dragon.ply"
  AttributeEnd
AttributeEnd
