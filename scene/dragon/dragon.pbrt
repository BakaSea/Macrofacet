Sampler "halton"
  "integer pixelsamples" 16
LookAt 1 0.8 1.7
       0.15 0 0
       0 1 0

Camera "perspective"
    "float fov" 60

Film "rgb"
  "integer xresolution" 640
  "integer yresolution" 640
  "float cropwindow" [0 1 0.21875 0.78125]
  "string filename" "dragon.exr"

Integrator "volpath"
  #"integer maxdepth" 1

WorldBegin

#LightSource "infinite" "rgb L" [ 1 1 1 ]
AttributeBegin
  Rotate 180 0 0 1
  Rotate 90 1 0 0
  Rotate 90 0 0 1
  LightSource "infinite" "string filename" "FlowCheck.exr"
AttributeEnd

AttributeBegin
  Translate 0 -0.6 0
  Scale 10000 10000 10000
  Material "diffuse" "rgb reflectance" [ 0.15 0.15 0.15 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  MakeNamedMedium "macrofacet" "string type" "macrofacetvdb" 
    "string filename" "dragon-0005-005-01-1.nvdb"
    "rgb albedo" [ 0.7 0.7 0.7 ]
  AttributeBegin
    Material "interface"
    MediumInterface "macrofacet" ""
    #Material "conductor" "rgb reflectance" [1.0 1.0 1.0] "float roughness" 0.25
    Scale 2 0.5 1
    Shape "plymesh" "string filename" "cube.ply"
    #Shape "plymesh" "string filename" "dragon.ply"
  AttributeEnd
AttributeEnd
