Sampler "halton"
  "integer pixelsamples" 16
LookAt 0 0 6
       0 0 0
       0 1 0

Camera "perspective"
    "float fov" 60

Film "rgb"
  "integer xresolution" 512
  "integer yresolution" 512
  "string filename" "bunny.exr"

Integrator "volpath"
  #"integer maxdepth" 1

WorldBegin

#LightSource "infinite" "rgb L" [ 1 1 1 ]

AttributeBegin
  Translate 5 0 0
  Rotate 90 0 0 1
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.9 0.1 0.1 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 0 -5
  Rotate 90 1 0 0
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.1 0.9 0.1 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate -5 0 0
  Rotate 90 0 0 1
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.1 0.1 0.9 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 -5 0
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 5 0
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 4.95 0
  Scale 2 2 2
  AreaLightSource "diffuse" "rgb L" [ 1 1 1 ] "float scale" 3
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Rotate 180 0 1 0
  Scale 1 1 1
  MakeNamedMedium "macrofacet" "string type" "macrofacetvdb" 
    "string filename" "bunny-01.nvdb"
    "rgb albedo" [ 1 1 1 ]
  AttributeBegin
    Material "interface"
    MediumInterface "macrofacet" ""
    #Material "conductor" "rgb reflectance" [1 1 1] "float roughness" 0.25
    Shape "sphere" "float radius" [ 2 ]
    #Shape "plymesh" "string filename" "bunny.ply"
  AttributeEnd
AttributeEnd
