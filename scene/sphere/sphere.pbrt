Sampler "halton"
  "integer pixelsamples" 64
LookAt 0 0 6
       0 0 0
       0 1 0

Camera "perspective"
    "float fov" 60

Film "rgb"
  "integer xresolution" 512
  "integer yresolution" 512
  "string filename" "sphere.exr"

Integrator "volpath"
  #"integer maxdepth" 1

WorldBegin

LightSource "infinite" "rgb L" [ 1 1 1 ]

AttributeBegin
  Translate 5 0 0
  Rotate 90 0 0 1
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.9 0.1 0.1 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 0 -5
  Rotate 90 1 0 0
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.1 0.9 0.1 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate -5 0 0
  Rotate 90 0 0 1
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.1 0.1 0.9 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 -5 0
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 0 5 0
  Scale 5 5 5
  Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
  Shape "trianglemesh"  "integer indices" [0 2 1 0 3 2 ]
    "point3 P" [1 0 -1    -1 0 -1    -1 0 1    1 0 1 ]
AttributeEnd

MakeNamedMedium "homo" "string type" "homogeneous" "rgb sigma_a" [0.2 0.3 0.4] "rgb sigma_s" [0.8 0.7 0.6]

AttributeBegin
  MakeNamedMedium "macrofacet" "string type" "spheremacrofacet"
    "string ndf" "gp"
    "float alpha" [ 0.5 ]
    "float alphaz" [ 0.5 ]
    "float sigma" [ 0.01 ]
  AttributeBegin
    Material "interface"
    MediumInterface "macrofacet" ""
    #MediumInterface "homo" ""
    #Material "diffuse"
    #Material "conductor" "float roughness" [ 0.25 ] "rgb reflectance" [1.0 1.0 1.0] "string ndf" "beckmann"
    Shape "sphere" "float radius" [ 1.03 ]
  AttributeEnd
AttributeEnd