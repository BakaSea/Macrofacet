Sampler "halton"
  "integer pixelsamples" 16
LookAt 3 0 0
       0 0 0
       0 0 1

Camera "perspective"
    "float fov" 60

Film "rgb"
  "integer xresolution" 512
  "integer yresolution" 512
  "string filename" "sphere-brdf.exr"

Integrator "volpath"
  #"integer maxdepth" 1

WorldBegin

AttributeBegin
LightSource "infinite" "string filename" "envmap.exr"
AttributeEnd

AttributeBegin
  MakeNamedMedium "macrofacet" "string type" "spheremacrofacet"
    "string ndf" "gp"
    "rgb albedo" [0.8 0.8 0.8]
    "float alpha" [ 0.1 ]
    "float alphaz" [ 0.1 ]
    "float sigma" [ 0.001 ]
  AttributeBegin
    #Material "interface"
    #MediumInterface "macrofacet" ""
    #MediumInterface "homo" ""
    Material "conductor" "string ndf" "beckmann" "bool remaproughness" false "float roughness" [ 0.1 ] "rgb reflectance" [0.8 0.8 0.8]
    Shape "sphere" "float radius" [ 1.003 ]
  AttributeEnd
AttributeEnd