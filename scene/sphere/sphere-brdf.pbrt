Sampler "halton"
  "integer pixelsamples" 512
LookAt 3 0 0
       0 0 0
       0 0 1

Camera "perspective"
    "float fov" 60

Film "rgb"
  "integer xresolution" 512
  "integer yresolution" 512
  "string filename" "sphere-brdf.exr"

Integrator "volpath"
  #"integer maxdepth" 1

WorldBegin

AttributeBegin
LightSource "infinite" "string filename" "envmap.exr"
AttributeEnd

AttributeBegin
  MakeNamedMedium "macrofacet" "string type" "spheremacrofacet"
    "float alpha" [ 1.0 ]
    "float sigma" [ 0.001 ]
  AttributeBegin
    Material "interface"
    MediumInterface "macrofacet" ""
    #MediumInterface "homo" ""
    #Material "conductor" "string ndf" "beckmann" "bool remaproughness" false "float roughness" [ 0.1 ] "rgb reflectance" [1.0 1.0 1.0]
    Shape "sphere" "float radius" [ 1.003 ]
  AttributeEnd
AttributeEnd